{
  "manifest_version": 3,
  "name": "PassenD Client",
  "version": "0.17.1",
  "description": "Klien browser untuk PassenD password manager (Android).",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PassenD"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "passend@few.com",
      "strict_min_version": "109.0"
    }
  }
}