<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PassenDApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.PassenD">

        <activity android:name=".ui.LockActivity" android:exported="true"
            android:excludeFromRecents="true" android:launchMode="singleTask">
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.SetupActivity" android:exported="false" />
        <activity android:name=".ui.VaultActivity" android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".ui.PairingActivity" android:exported="false" />
        <activity android:name=".ui.BackupActivity" android:exported="false" />
        <activity android:name=".ui.ChangePasswordActivity" android:exported="false" />
        <activity android:name=".ui.ImportCsvActivity" android:exported="false" />
        <activity android:name=".ui.ExportCsvActivity" android:exported="false" />
        <activity android:name=".ui.PasswordHealthActivity" android:exported="false" />
        <activity android:name=".ui.ShareQrActivity" android:exported="false" />
        <activity android:name=".ui.PassphraseActivity" android:exported="false" />
        <activity android:name=".ui.HistoryExportActivity" android:exported="false" />
        <activity android:name=".ui.ImportXmlActivity" android:exported="false" />
        <activity android:name=".ui.FieldTemplatesActivity" android:exported="false" />
        <activity android:name=".ui.AboutActivity" android:exported="false" />
        <activity android:name=".ui.LicensesActivity" android:exported="false" />
        <activity android:name=".ui.edit.EditCredentialActivity" android:exported="false" />

        <service android:name=".service.WebSocketServerService"
            android:exported="false" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
