<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Setup Vault" android:textSize="26sp" android:textStyle="bold"
        android:layout_marginBottom="24dp"/>
    <EditText android:id="@+id/etMasterPassword"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/hint_master" android:inputType="textPassword"
        android:layout_marginBottom="12dp"/>
    <EditText android:id="@+id/etMasterConfirm"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/hint_master_confirm" android:inputType="textPassword"
        android:layout_marginBottom="24dp"/>
    <Button android:id="@+id/btnCreate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/btn_create"/>
</LinearLayout>