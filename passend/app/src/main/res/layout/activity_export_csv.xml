<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export CSV" android:textSize="22sp"
            android:textStyle="bold" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export semua kredensial ke file CSV PLAINTEXT yang bisa diimpor ke Chrome, Bitwarden, 1Password, dll."
            android:textSize="13sp" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠ File CSV tidak terenkripsi. Siapa pun yang bisa membukanya bisa melihat semua password. Gunakan hanya untuk migrasi, lalu hapus filenya."
            android:textSize="12sp" android:textColor="#C62828"
            android:padding="10dp" android:background="#FFEBEE"
            android:layout_marginBottom="20dp"/>

        <TextView android:id="@+id/tvCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Memuat…" android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <CheckBox android:id="@+id/cbIncludeOtp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sertakan TOTP secret (base32)"
            android:checked="true"
            android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btnExport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export ke File…"
            android:backgroundTint="#2E7D32"
            android:layout_marginBottom="16dp"/>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>