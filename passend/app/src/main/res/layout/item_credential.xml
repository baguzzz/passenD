<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:clickable="true" android:focusable="true">

    <TextView android:id="@+id/tvAvatar"
        android:layout_width="44dp" android:layout_height="44dp"
        android:gravity="center"
        android:textSize="16sp" android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvSite"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvUser"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:layout_marginTop="2dp"/>
    </LinearLayout>
</LinearLayout>