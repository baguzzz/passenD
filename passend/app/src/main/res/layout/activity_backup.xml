<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Backup Vault" android:textSize="22sp"
            android:textStyle="bold" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Backup terenkripsi dengan passphrase terpisah dari master password. Simpan file &amp; passphrase di tempat aman."
            android:textSize="13sp" android:layout_marginBottom="16dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Passphrase backup:" android:textSize="12sp"
            android:layout_marginBottom="4dp"/>
        <EditText android:id="@+id/etPassphrase"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="Minimal 8 karakter"
            android:layout_marginBottom="8dp"/>

        <EditText android:id="@+id/etPassphraseConfirm"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:hint="Konfirmasi passphrase (untuk export)"
            android:layout_marginBottom="16dp"/>

        <Button android:id="@+id/btnExport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Export ke File…"
            android:layout_marginBottom="20dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#DDDDDD" android:layout_marginBottom="20dp"/>

        <Button android:id="@+id/btnPickImport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Pilih File Backup untuk Import"
            android:layout_marginBottom="8dp"/>

        <Button android:id="@+id/btnImport"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Import File Terpilih"
            android:visibility="gone"
            android:backgroundTint="#2E7D32"/>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textSize="12sp"
            android:layout_marginTop="16dp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>